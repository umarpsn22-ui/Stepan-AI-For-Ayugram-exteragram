# The AI chat is opened as a fullscreen Android dialog.
# This deliberately avoids relying on Java BaseFragment subclass proxies,
# which are not consistently available on older SDK 1.4.3.3 builds.
StepanAIChatFragment = None


class _AIHostDestroyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        super().__init__()

    def before_hooked_method(self, param):
        try:
            dialog = getattr(self.plugin, "_ai_chat_dialog", None)
            if dialog is None or not dialog.isShowing():
                return
            host = getattr(self.plugin, "_ai_chat_dialog_host", None)
            current = param.thisObject
            # Do not dismiss the independent AI dialog merely because Telegram
            # destroys/replaces a channel fragment during unread-message navigation.
            # The AI request is intentionally independent from chat navigation.
            return
        except Exception:
            pass


class _AIChatActivityResultHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        super().__init__()

    def after_hooked_method(self, param):
        try:
            if not param.args or len(param.args) < 3:
                return
            request_code = int(param.args[0])
            if request_code not in (
                int(self.plugin.AI_FILE_PICK_REQUEST),
                int(self.plugin.AI_WALLPAPER_PICK_REQUEST),
            ):
                return
            result_code = int(param.args[1])
            data = param.args[2]
            activity = param.thisObject
            if Activity is not None and result_code != int(Activity.RESULT_OK):
                return
            if data is None:
                return
            uri = data.getData()
            if uri is None:
                return
            if request_code == int(self.plugin.AI_WALLPAPER_PICK_REQUEST):
                self.plugin._handle_ai_wallpaper_picked(activity, uri)
            else:
                self.plugin._handle_ai_file_picked(activity, uri)
        except Exception as e:
            try:
                self.plugin._file_log("AI file picker result failed: %s" % e)
            except Exception:
                pass


