            Input(key=self.LINK_API_KEY_KEY, text=self._tr("API-ключ VirusTotal"), default=str(self.get_setting(self.LINK_API_KEY_KEY, "") or ""), subtext=self._tr("Вставь сюда Public API Key из VirusTotal."), icon="msg_key"),
            Text(
                text=self._tr("🔑 Получить API-ключ VirusTotal"),
                subtext=api_key_url,
