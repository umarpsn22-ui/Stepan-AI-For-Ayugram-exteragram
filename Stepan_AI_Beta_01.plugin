    def _default_prompt(self, key):
        if self._language() == "en":
            return self.EN_DEFAULT_PROMPTS.get(key, self.DEFAULT_PROMPTS.get(key, ""))
        if self._language() == "uk":
            return self.UK_DEFAULT_PROMPTS.get(key, self.DEFAULT_PROMPTS.get(key, ""))
        return self.DEFAULT_PROMPTS.get(key, "")

    EXTRA_EN_TRANSLATIONS.update({'Постоянная память отдельно для каждого чата': 'Persistent memory for each chat', 'Контекст одного диалога не смешивается с другим.': 'Context from one conversation is not mixed with another.', 'Вставь сюда Public API Key из VirusTotal.': 'Paste your Public API Key from VirusTotal here.', 'Как получить ключ': 'How to get a key', 'Что означают значки': 'What the icons mean', 'Больше не используются.': 'No longer used.', 'Короткое описание стиля и правил ответа.': 'Short description of response style and rules.', 'Дополнительные правила поведения именно этого провайдера.': 'Additional behavior rules for this provider.', 'Сохраняется локально и используется только этим провайдером.': 'Stored locally and used only by this provider.', 'Провайдер для проверки': 'Provider used for testing', 'Последний результат': 'Latest result', 'Выбранный AI': 'Selected AI', 'Система': 'System', 'Состояние': 'Status', 'Примечание': 'Note'})

