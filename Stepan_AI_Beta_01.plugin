            Text(text=self._tr("🗑 Очистить кэш ссылок"), subtext=self._tr("Удалить сохранённые результаты"), icon="msg_delete", accent=True, on_click=lambda view: self._clear_link_cache()),
        ]

    def _create_file_safety_page(self):
        enabled = self.get_setting(self.FILE_CHECK_ENABLED_KEY, True)
        if isinstance(enabled, str):
            enabled = enabled.lower() not in ("0", "false", "off", "no")
        enabled = bool(enabled)
        return [
            Header(text=self._tr("🔎 Проверка файлов")),
            Selector(
                key=self.FILE_CHECK_ENABLED_KEY,
                text=self._tr("Проверка файлов в сообщениях"),
                default=1 if enabled else 0,
                items=[self._tr("Выключена"), self._tr("Включена")],
                icon="msg_security",
            ),
            self._detail_row(
                "Как работает",
                "Ручная проверка через меню сообщения.",
                "Зажми сообщение с документом и открой «Плагины → Проверить файл». Плагин скачает файл из Telegram, посчитает SHA-256 и сначала попробует найти готовый отчёт VirusTotal. Если готового отчёта нет, файл отправляется на анализ. Повторные проверки используют локальный кэш.",
                "msg_info",
            ),
            self._detail_row(
                "Конфиденциальность проверки файлов",
                "Важно для личных и конфиденциальных документов.",
                "Public API VirusTotal предназначен для публичной инфраструктуры анализа. Загруженные файлы могут участвовать в общем VirusTotal-корпусе и передаваться партнёрам для анализа. Не проверяй здесь личные документы, приватные архивы, ключи, пароли или другие чувствительные файлы.",
                "msg_warning",
            ),
            self._detail_row(
                "Лимит размера файла",
                "Максимум 650 МБ в текущей реализации.",
                "Файлы до 32 МБ отправляются напрямую через POST /files. Для более крупных файлов плагин запрашивает специальный upload URL VirusTotal. Жёсткий локальный предел этой версии — 650 МБ; файлы крупнее примерно 200 МБ могут проверяться дольше и давать менее полный результат.",
                "msg_info",
            ),
        ]

